# Configuracao do Firebase para o painel, §A.6: nenhum valor entra no repositorio.
#
# Em producao o painel NAO usa este arquivo: servido pelo Hosting do Firebase,
# ele le a configuracao do endereco reservado /__/firebase/init.json, que o
# proprio Hosting serve. Estas variaveis existem so para rodar na maquina, em
# desenvolvimento.
#
# Para criar o seu painel/.env.local (ignorado pelo .gitignore no padrao .env.*),
# copie este arquivo e preencha com a saida de:
#
#   firebase apps:list WEB --project a-fabrica-soulan
#   firebase apps:sdkconfig WEB <id-do-app> --project a-fabrica-soulan
#
# O id do app sai do primeiro comando e nao fica escrito aqui: arquivo versionado
# nao carrega identificador nem valor da nuvem. O projeto vai sempre explicito, §A.20.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Opcional, so para provar contra o emulador local do Firebase.
# Ligue com 1 e suba os emuladores de Auth e Firestore.
NEXT_PUBLIC_EMULADOR=
NEXT_PUBLIC_EMULADOR_AUTH=127.0.0.1:9099
NEXT_PUBLIC_EMULADOR_FIRESTORE=127.0.0.1:8080
