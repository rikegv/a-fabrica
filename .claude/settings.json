{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/gate-deploy.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "TodoWrite",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(git status)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Write(.claude/state/PROD_*)",
      "Edit(.claude/state/PROD_*)",
      "Write(.claude/state/**)",
      "Edit(.claude/state/**)",
      "Write(scripts/gate-deploy.sh)",
      "Edit(scripts/gate-deploy.sh)",
      "Write(scripts/autorizar-producao.sh)",
      "Edit(scripts/autorizar-producao.sh)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.json)"
    ]
  }
}
