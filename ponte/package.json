{
  "name": "a-fabrica-ponte",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "Ponte local da Fabrica: pilota o Claude Code e conversa com a base no Firestore. TypeScript estrito, Node 20, so conexao de saida.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tipos": "tsc --noEmit -p tsconfig.json",
    "compilar": "tsc -p tsconfig.json",
    "ponte": "node dist/ponte.js",
    "ponte:emulador": "cross-env PONTE_EMULADOR=1 node dist/ponte.js",
    "entrar": "node dist/entrar.js",
    "colar": "tsc -p tsconfig.json && node dist/entrar.js --colar",
    "testes": "node dist/testes/sete-testes.js",
    "testes:emulador": "cross-env PONTE_EMULADOR=1 node dist/testes/sete-testes.js",
    "base-real": "tsc -p tsconfig.json && node dist/testes/sete-testes.js",
    "prova:ressalvas": "tsc -p tsconfig.json && node dist/testes/prova-ressalvas.js",
    "prova:colagem": "tsc -p tsconfig.json && node dist/testes/prova-colagem.js",
    "prova:tempo": "tsc -p tsconfig.json && node dist/testes/prova-tempo-esgotado.js",
    "prova:tempo:emulador": "tsc -p tsconfig.json && cross-env PONTE_EMULADOR=1 node dist/testes/prova-tempo-esgotado.js",
    "prova:sessao": "tsc -p tsconfig.json && node dist/testes/prova-sessao-colada.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.0"
  }
}
